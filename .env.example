# Copy to .env (git-ignored) before running `docker compose up`:
#   cp .env.example .env
#
# These values are for LOCAL DEVELOPMENT ONLY. They are committed, so they are public.
# The API refuses the dev JWT secret below unless the 'local'/'docker' Spring profile is active.
# For any shared, staging or production environment generate fresh values, e.g.:
#   openssl rand -base64 64

# JWT signing secret (HS512, at least 64 bytes)
JWT_SECRET=docker-dev-only-jwt-secret-NOT-FOR-PRODUCTION-0123456789abcdefghijklmnopqrstuvwxyz

# Access token lifetime in milliseconds (15 minutes)
JWT_EXPIRATION=900000

# Postgres password for the local compose database
POSTGRES_PASSWORD=local_dev_password

# Comma-separated browser origins allowed by CORS (Expo web dev server)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Video calls (LiveKit). The local/docker Spring profiles default to the public dev pair of
# `livekit-server --dev` (devkey/secret). Uncomment only to override; never commit real keys.
# LIVEKIT_URL=http://livekit:7880          # server-side API URL used by the API
# LIVEKIT_CLIENT_URL=ws://localhost:7880   # URL returned to browsers
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# Swagger UI (/swagger-ui.html) and the OpenAPI document (/v3/api-docs) are OFF in the docker
# profile. Set true only on a trusted development machine; keep false anywhere reachable by others.
SWAGGER_ENABLED=false
