# Copy to .env (git-ignored) before running `docker compose up`:
#   cp .env.example .env
#
# These values are for LOCAL DEVELOPMENT ONLY. They are committed, so they are public.
# docker compose reads this file for its own substitutions, passes every variable to the API container
# (env_file) and passes EXPO_PUBLIC_* / CSP_CONNECT_SRC to the web container. An API started on the host
# (`./mvnw spring-boot:run`) does not read this file: export the variables in that shell instead.
#
# Every setting below except the first block is OPTIONAL: application.yml holds the default shown after
# the '=' and the 'local'/'docker' profiles add development defaults. Uncomment a line only to change it.
# The full reference with comments is backend/carenexus-api/src/main/resources/application.yml; the
# README explains environments, providers and what production must set.
#
# For any shared, staging or production environment generate fresh secrets, e.g.:
#   openssl rand -base64 64     (JWT_SECRET)
#   openssl rand -base64 32     (AUTH_MFA_ENCRYPTION_KEY)
#   openssl rand -hex 32        (BILLING_LOCAL_WEBHOOK_SECRET)

# ---- Required by docker compose ----------------------------------------------------------------------------------

# JWT signing secret (HS512, at least 64 bytes). The API refuses this value outside the local/docker/test profiles.
JWT_SECRET=docker-dev-only-jwt-secret-NOT-FOR-PRODUCTION-0123456789abcdefghijklmnopqrstuvwxyz

# Access token lifetime in milliseconds (15 minutes)
JWT_EXPIRATION=900000

# Postgres password for the local compose database
POSTGRES_PASSWORD=local_dev_password

# Comma-separated browser origins allowed by CORS (web container / Expo web dev server). No wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Swagger UI (/swagger-ui.html) and the OpenAPI document (/v3/api-docs) are OFF in the docker
# profile. Set true only on a trusted development machine; keep false anywhere reachable by others.
SWAGGER_ENABLED=false

# ---- Web container (carenexus-web) -------------------------------------------------------------------------------
# Build-time values are inlined into the bundle: run `docker compose up -d --build carenexus-web` after a change.
# EXPO_PUBLIC_API_URL=http://localhost:9000         # API origin as the browser sees it
# EXPO_PUBLIC_SUPPORT_EMAIL=                        # Help & Support fallback when GET /api/settings/public has none
# Read at container start: the API and LiveKit origins the browser may connect to (space-separated).
# CSP_CONNECT_SRC="http://localhost:9000 ws://localhost:7880"

# ---- Environment and safety switches -----------------------------------------------------------------------------
# development | staging | production. The local/docker/test profiles refuse staging and production.
# CARENEXUS_ENVIRONMENT=development
# With production, a seam on its local implementation fails startup unless this is true (see README).
# CARENEXUS_ALLOW_LOCAL_PROVIDERS=false
# Public URL of the web app, used in links in emails and notifications. No trailing slash.
# CARENEXUS_WEB_BASE_URL=http://localhost:8081
# Optional first administrator, created once at startup when no active ADMIN exists (verified email). Password at
# least 12 characters. Remove both after the first start. The dev seed already has admin@carenexus.com.
# CARENEXUS_BOOTSTRAP_ADMIN_EMAIL=
# CARENEXUS_BOOTSTRAP_ADMIN_PASSWORD=

# ---- Accounts ----------------------------------------------------------------------------------------------------
# Sign-in requires a confirmed email (default true; the local/docker profiles default to false).
# AUTH_REQUIRE_VERIFIED_EMAIL=false
# Roles that must use TOTP two-factor sign-in: PATIENT, DOCTOR, CAREGIVER, ADMIN (default ADMIN; empty in dev profiles).
# AUTH_MFA_REQUIRED_ROLES=
# Base64 of 32 random bytes that encrypts TOTP secrets. Mandatory outside the local/docker/test profiles; the
# dev profiles carry a committed value that is refused elsewhere.
# AUTH_MFA_ENCRYPTION_KEY=
# AUTH_PASSWORD_RESET_TTL_MINUTES=45       # 5-1440
# AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
# AUTH_EMAIL_CHANGE_TTL_HOURS=24
# AUTH_MFA_CHALLENGE_TTL_SECONDS=300
# AUTH_HUMAN_VERIFICATION=none             # only value shipped; an unknown value fails startup
# AUTH_LICENCE_REGISTRY=manual             # only value shipped; an unknown value fails startup

# ---- Provider seams (local implementations; see the README table) -------------------------------------------------
# DELIVERY_EMAIL_PROVIDER=local            # local | disabled
# DELIVERY_SMS_PROVIDER=local              # local | disabled
# DELIVERY_PUSH_PROVIDER=local             # local | disabled
# DELIVERY_MAX_ATTEMPTS=5                  # send attempts before an outbound message is FAILED
# DELIVERY_BATCH_SIZE=200                  # messages per worker pass (capped at 200)
# STORAGE_PROVIDER=local                   # files under STORAGE_LOCAL_DIR
# STORAGE_LOCAL_DIR=                       # default <java.io.tmpdir>/carenexus-storage; must be writable
# STORAGE_SCANNER=local                    # magic-byte type check + EICAR test string
# BILLING_PROVIDER=local                   # payment gateway
# BILLING_CLAIMS_PROVIDER=manual           # insurance claims moved by an administrator
# HMAC secret of the local gateway's callback: random, at least 32 characters outside the dev profiles.
# BILLING_LOCAL_WEBHOOK_SECRET=
# AI_PROVIDER=rules                        # risk detection: rules | disabled
# AI_ASSESSMENT_TIMEOUT_MS=3000
# AI_INTERACTION_PROVIDER=rules            # medication interactions: rules | disabled
# HEALTH_WEARABLES_PROVIDER=disabled
# TERMINOLOGY_PROVIDER=bundled
# TERMINOLOGY_BUNDLED_RESOURCE=terminology/icd10-subset.tsv

# ---- Rate limits --------------------------------------------------------------------------------------------------
# Set false for the browser end-to-end suites (they exceed the sign-in and conversation buckets).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORE=memory                  # counters per API instance
# RATE_LIMIT_MAX_TRACKED_KEYS=100000
# One bucket: CARENEXUS_RATELIMIT_BUCKETS_<NAME>_LIMIT / _WINDOWSECONDS, e.g.
# CARENEXUS_RATELIMIT_BUCKETS_MESSAGESEND_LIMIT=120

# ---- Clinic, booking, reminders, billing defaults ----------------------------------------------------------------
# CLINIC_NAME=                             # empty = "CareNexus"; administrators can override it in System settings
# SUPPORT_CONTACT_EMAIL=                   # Help & Support contact (falls back to SUPPORT_EMAIL)
# SUPPORT_CONTACT_PHONE=                   # (falls back to SUPPORT_PHONE)
# SCHEDULING_TIME_ZONE=Africa/Harare
# SCHEDULING_OPEN_HOUR=8
# SCHEDULING_CLOSE_HOUR=18
# SCHEDULING_ALLOW_WEEKENDS=true
# SCHEDULING_MAX_ADVANCE_DAYS=365
# SCHEDULING_NEEDS_OUTCOME_AFTER_MINUTES=30
# REMINDERS_APPOINTMENT_LEAD_HOURS=24      # 1-168
# REMINDERS_SECOND_LEAD_MINUTES=60         # 5-720
# MEDICATION_MISSED_GRACE_MINUTES=120
# AI_MISSED_DOSE_THRESHOLD=3
# AI_ANOMALY_DEVIATION_PERCENT=25
# AI_FOLLOW_UP_LOOKBACK_DAYS=30
# BILLING_DEFAULT_CURRENCY=KES
# BILLING_TAX_RATE=0                       # fraction 0-1
# BILLING_PAYMENT_TERMS_DAYS=14
# BILLING_AUTO_INVOICE=DRAFT               # DRAFT | SENT | OFF
# BILLING_OVERDUE_GRACE_DAYS=0
# Vital-sign reference ranges (defaults in application.yml), relaxed names, e.g.:
# CARENEXUS_HEALTH_RANGES_HEARTRATE_HIGH=100

# ---- Retention (days) ---------------------------------------------------------------------------------------------
# RETENTION_TOKENS_DAYS=30
# RETENTION_READ_NOTIFICATIONS_DAYS=180
# RETENTION_OUTBOUND_MESSAGES_DAYS=30
# RETENTION_CALL_RECORDS_DAYS=30
# RETENTION_EXPORT_DAYS=7

# ---- Background jobs (milliseconds) --------------------------------------------------------------------------------
# CARENEXUS_JOBS_ENABLED=true              # false stops every scheduled job on this instance
# JOBS_OUTBOUND_INTERVAL_MS=5000
# JOBS_REMINDERS_INTERVAL_MS=60000
# JOBS_REMINDERS_INITIAL_DELAY_MS=30000
# JOBS_APPOINTMENT_REMINDERS_INTERVAL_MS=60000
# JOBS_APPOINTMENT_REMINDERS_INITIAL_DELAY_MS=60000
# JOBS_MEDICATION_REMINDERS_INTERVAL_MS=60000
# JOBS_MEDICATION_REMINDERS_INITIAL_DELAY_MS=60000
# JOBS_MEDICATION_SCHEDULE_INTERVAL_MS=900000
# JOBS_MEDICATION_SCHEDULE_INITIAL_DELAY_MS=60000
# JOBS_NEEDS_OUTCOME_NUDGE_INTERVAL_MS=86400000
# JOBS_NEEDS_OUTCOME_NUDGE_INITIAL_DELAY_MS=120000
# JOBS_FOLLOW_UP_DUE_INTERVAL_MS=86400000
# JOBS_FOLLOW_UP_DUE_INITIAL_DELAY_MS=300000
# JOBS_PRESCRIPTION_EXPIRY_INTERVAL_MS=3600000
# JOBS_ACCESS_REQUESTS_INTERVAL_MS=86400000
# JOBS_ACCESS_EXPIRY_NOTICE_INTERVAL_MS=86400000
# JOBS_DATA_EXPORT_EXPIRY_INTERVAL_MS=3600000
# JOBS_RETENTION_INTERVAL_MS=3600000
# JOBS_INVOICE_OVERDUE_INTERVAL_MS=3600000
# JOBS_PAYMENT_RECONCILE_INTERVAL_MS=300000
# MESSAGING_ACCESS_EXPIRY_SWEEP_MS=60000

# ---- Video calls and messaging -------------------------------------------------------------------------------------
# The local/docker profiles default to the public dev pair of `livekit-server --dev` (devkey/secret).
# Never commit real keys.
# LIVEKIT_ENABLED=true                     # set by the dev profiles; staging and production set it explicitly
# LIVEKIT_URL=http://livekit:7880          # server-side API URL used by the API
# LIVEKIT_CLIENT_URL=ws://localhost:7880   # URL returned to browsers
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# LIVEKIT_WEBHOOK_ENABLED=true
# LIVEKIT_TOKEN_TTL_SECONDS=300
# LIVEKIT_MAX_PARTICIPANTS=6
# CALLS_JOIN_OPENS_MINUTES_BEFORE=15
# CALLS_JOIN_CLOSES_MINUTES_AFTER_END=60
# CALLS_WORKER_ENABLED=true
# CALLS_WORKER_INTERVAL_MS=5000
# CALLS_SWEEPER_INTERVAL_MS=60000
# MESSAGING_MAX_BODY_LENGTH=4000

# ---- Server, database pool, uploads, metrics -----------------------------------------------------------------------
# SERVER_PORT=9000
# SERVER_MAX_HTTP_REQUEST_HEADER_SIZE=8KB
# SERVER_MAX_FORM_POST_SIZE=2MB
# SERVER_MAX_SWALLOW_SIZE=2MB
# SERVER_CONNECTION_TIMEOUT=20s
# SERVER_MAX_THREADS=200
# SERVER_MIN_SPARE_THREADS=10
# SERVER_ACCEPT_COUNT=100
# SHUTDOWN_TIMEOUT=30s
# UPLOAD_MAX_FILE_SIZE=10MB
# UPLOAD_MAX_REQUEST_SIZE=12MB
# DB_POOL_MAX_SIZE=20
# DB_POOL_MIN_IDLE=5
# DB_POOL_CONNECTION_TIMEOUT_MS=10000
# DB_POOL_IDLE_TIMEOUT_MS=300000
# DB_POOL_MAX_LIFETIME_MS=1500000
# METRICS_PROMETHEUS_ENABLED=true          # /actuator/prometheus: the scrape token below or an ADMIN token
# METRICS_SCRAPE_TOKEN=                    # Prometheus bearer token, 32+ chars (openssl rand -hex 32); set it in staging/production
