# Base URL of the CareNexus API (Spring Boot). Read at build time by Expo.
# Copy to .env.development.local / .env.production.local (git-ignored) and adjust.
#
# Web or simulator on the same machine as the API:
EXPO_PUBLIC_API_URL=http://localhost:9000
#
# Physical device on your local network: use your computer's LAN address, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:9000
#
# Production: the public HTTPS API origin, e.g.
# EXPO_PUBLIC_API_URL=https://api.example.com
