# Build-time settings of the CareNexus web/native app. Expo inlines every EXPO_PUBLIC_* value into the bundle,
# so they are public and a change needs a rebuild (or a restart of `npx expo start`).
# Copy to .env.development.local / .env.production.local (git-ignored) and adjust. The web container
# (frontend/Dockerfile, docker compose service carenexus-web) takes the same names as build arguments instead.

# Base URL of the CareNexus API (Spring Boot).
#
# Web or simulator on the same machine as the API:
EXPO_PUBLIC_API_URL=http://localhost:9000
#
# Physical device on your local network: use your computer's LAN address, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:9000
#
# Staging / production: the public HTTPS API origin, e.g.
# EXPO_PUBLIC_API_URL=https://api.example.com

# Support email shown on Help & Support only when GET /api/settings/public cannot be loaded or has no support
# email (administrators set the real contact in System settings). Leave empty to show none.
# EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
