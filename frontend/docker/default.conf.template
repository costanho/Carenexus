# nginx site for the CareNexus web export (frontend/Dockerfile). Rendered at container start into
# /etc/nginx/conf.d/default.conf; only ${CSP_*} variables are substituted (NGINX_ENVSUBST_FILTER).
#
# Routing of the Expo Router static export:
#   /_expo/static/...            hashed bundles             long cache, 404 when missing
#   /assets/...                  fonts and images            one week, 404 when missing
#   /dashboard/call/<id>         the one dynamic route       its exported "[appointmentId].html" page
#   any other path with a file extension                     the file or 404 (never the app shell)
#   any other path                                            <path>.html, <path>/index.html, else index.html
#                                                             (the client router then shows the page or Not found)
# HTML is revalidated on every load so a new deployment is picked up at once.

server {
    listen 8081;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    charset utf-8;
    client_max_body_size 1k;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    # Container health check; no headers needed.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /_expo/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ^~ /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    location ~ ^/dashboard/call/[^/.]+/?$ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files "/dashboard/call/[appointmentId].html" /index.html;
    }

    location ~ \.[A-Za-z0-9]+$ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri.html $uri/index.html /index.html;
    }
}
